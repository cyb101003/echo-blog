---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config";

type Props = {
  title: string;
  description?: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  slug: string;
  previous?: { id: string; title: string };
  next?: { id: string; title: string };
};

const { title, description, publishedAt, updatedAt, tags, slug, previous, next } = Astro.props;
const date = publishedAt.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
const metaDescription = description ?? `${SITE.author}的文章：${title}`;
---

<BaseLayout
  title={`${title} — Echo`}
  description={metaDescription}
  image={`/og/${slug}.png`}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
  <article class="article-shell" data-article-slug={slug}>
    <header class="article-header" data-reveal>
      <a class="back-link" href="/posts/">← 返回文章</a>
      <p class="kicker">ARTICLE / {date}</p>
      <h1>{title}</h1>
      {description && <p class="article-deck">{description}</p>}
      <ul class="article-tags" aria-label="文章标签">
        {tags.map(tag => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
      </ul>
    </header>
    <div class="article-grid" data-reveal>
      <aside class="article-aside" aria-label="文章信息">
        <p><span>作者</span>{SITE.author}</p>
        <p><span>发布</span>{date}</p>
        {updatedAt && <p><span>更新</span>{updatedAt.toLocaleDateString("zh-CN")}</p>}
        <nav data-toc aria-label="文章目录"><p>目录</p><ol></ol></nav>
      </aside>
      <div class="prose" data-article-body>
        <slot />
      </div>
    </div>
    {(previous || next) && (
      <nav class="article-pagination" aria-label="相邻文章" data-reveal>
        <header class="article-pagination-heading">
          <p class="kicker">CONTINUE / KEEP READING</p>
          <h2>继续阅读</h2>
        </header>
        <div class="article-pagination-grid">
        {previous ? (
          <a class="article-pagination-card article-pagination-card--previous" href={`/posts/${previous.id}/`} data-direction="previous">
            <span class="pagination-card-top"><small>PREVIOUS / 上一篇</small><i class="pagination-arrow" aria-hidden="true">←</i></span>
            <strong>{previous.title}</strong>
            <span class="pagination-card-foot"><small>ARTICLE</small><i aria-hidden="true">01</i></span>
          </a>
        ) : null}
        {next ? (
          <a class="article-pagination-card article-pagination-card--next" href={`/posts/${next.id}/`} data-direction="next">
            <span class="pagination-card-top"><small>NEXT / 下一篇</small><i class="pagination-arrow" aria-hidden="true">→</i></span>
            <strong>{next.title}</strong>
            <span class="pagination-card-foot"><small>ARTICLE</small><i aria-hidden="true">02</i></span>
          </a>
        ) : null}
        </div>
      </nav>
    )}
  </article>
  <button class="back-to-top" type="button" data-back-to-top aria-label="返回顶部">↑</button>
</BaseLayout>

<script>
  function setupArticle() {
    const body = document.querySelector("[data-article-body]");
    if (!(body instanceof HTMLElement) || body.dataset.ready === "true") return;
    body.dataset.ready = "true";

    const toc = document.querySelector("[data-toc] ol");
    const headings = [...body.querySelectorAll("h2, h3")];
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = `section-${index + 1}`;
      const anchor = document.createElement("a");
      anchor.href = `#${heading.id}`;
      anchor.className = "heading-anchor";
      anchor.setAttribute("aria-label", `链接到 ${heading.textContent}`);
      anchor.textContent = "#";
      heading.append(anchor);

      if (toc) {
        const item = document.createElement("li");
        item.className = heading.tagName === "H3" ? "toc-subitem" : "";
        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent?.replace(/#$/, "") || `章节 ${index + 1}`;
        item.append(link);
        toc.append(item);
      }
    });

    body.querySelectorAll("pre").forEach(block => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-code";
      button.textContent = "复制";
      button.addEventListener("click", async () => {
        const code = block.querySelector("code")?.textContent || "";
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = "已复制";
        } catch {
          button.textContent = "复制失败";
        }
        window.setTimeout(() => { button.textContent = "复制"; }, 1600);
      });
      block.append(button);
    });

    const article = document.querySelector("[data-article-slug]");
    const slug = article instanceof HTMLElement ? article.dataset.articleSlug : "";
    const progress = document.querySelector("[data-reading-progress]");
    const topButton = document.querySelector("[data-back-to-top]");
    const tocLinks = [...document.querySelectorAll("[data-toc] a")];
    const controller = new AbortController();
    let ticking = false;

    const update = () => {
      ticking = false;
      const bodyTop = body.getBoundingClientRect().top + window.scrollY;
      const start = bodyTop - window.innerHeight * 0.22;
      const end = bodyTop + body.offsetHeight - window.innerHeight * 0.58;
      const value = Math.max(0, Math.min(1, (window.scrollY - start) / Math.max(1, end - start)));

      if (progress instanceof HTMLElement) progress.style.transform = `scaleX(${value})`;
      if (topButton instanceof HTMLElement) topButton.classList.toggle("visible", window.scrollY > 600);

      const activeHeading = [...headings].reverse().find(heading => heading.getBoundingClientRect().top <= 170) || headings[0];
      tocLinks.forEach(link => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const selected = Boolean(activeHeading?.id) && link.getAttribute("href") === `#${activeHeading.id}`;
        link.classList.toggle("is-active", selected);
        if (selected) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });

      if (slug) {
        try {
          const key = `echo:reading:${slug}`;
          const previousValue = Number(window.localStorage.getItem(key) || 0);
          if (value > previousValue) window.localStorage.setItem(key, String(value));
        } catch {
          // Reading progress remains available for this page when storage is restricted.
        }
      }
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    window.addEventListener("scroll", requestUpdate, { passive: true, signal: controller.signal });
    window.addEventListener("resize", requestUpdate, { passive: true, signal: controller.signal });
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true });
    requestUpdate();
    topButton?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }), { signal: controller.signal });
  }

  document.addEventListener("astro:page-load", setupArticle);
  setupArticle();
</script>
