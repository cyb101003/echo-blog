---
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import DotField from "@/components/DotField.astro";
import { SITE } from "@/config";
import "@/styles/global.css";
import "@/styles/enhancements.css";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  searchIndex?: boolean;
  immersive?: boolean;
};

const {
  title = SITE.title,
  description = SITE.description,
  image = "/og/home.png",
  type = "website",
  publishedAt,
  updatedAt,
  noindex = false,
  searchIndex = true,
  immersive = false
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, siteOrigin);
const imageUrl = new URL(image, siteOrigin);
const baiduVerification = import.meta.env.BAIDU_SITE_VERIFICATION?.trim();
const personSchema = {
  "@type": "Person",
  "@id": `${canonical.origin}/#person`,
  name: SITE.author,
  alternateName: [SITE.displayName, SITE.realName],
  description: SITE.description,
  url: canonical.origin,
  image: new URL("/assets/echo-avatar.jpg", siteOrigin).href,
  jobTitle: SITE.roles.map(role => role.label),
  affiliation: SITE.roles.map(role => ({ "@type": "Organization", name: role.organization })),
  sameAs: [SITE.github, SITE.youtube, SITE.x],
  subjectOf: { "@type": "CreativeWork", name: "Echo（陈宇博）的个人介绍", url: SITE.zhihu },
  knowsAbout: ["AI 产品", "Web 开发", "开源", "Web3", "Solidity"]
};
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${canonical.origin}/#website`,
  name: SITE.title,
  description: SITE.description,
  url: canonical.origin,
  inLanguage: SITE.locale,
  publisher: { "@id": `${canonical.origin}/#person` },
  potentialAction: {
    "@type": "SearchAction",
    target: `${canonical.origin}/search/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
const articleSchema = type === "article"
  ? {
      "@type": "BlogPosting",
      headline: title,
      description,
      image: imageUrl.href,
      datePublished: publishedAt?.toISOString(),
      ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
      author: { "@id": `${canonical.origin}/#person` },
      publisher: { "@id": `${canonical.origin}/#person` },
      inLanguage: SITE.locale,
      mainEntityOfPage: canonical.href,
      isPartOf: { "@id": `${canonical.origin}/#website` }
    }
  : undefined;
const profilePageSchema = type === "profile"
  ? {
      "@type": "ProfilePage",
      "@id": canonical.href,
      name: title,
      description,
      url: canonical.href,
      inLanguage: SITE.locale,
      mainEntity: { "@id": `${canonical.origin}/#person` },
      isPartOf: { "@id": `${canonical.origin}/#website` }
    }
  : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, ...(articleSchema ? [articleSchema] : []), ...(profilePageSchema ? [profilePageSchema] : [])]
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0c0f" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="keywords" content={SITE.keywords.join(", ")} />
    <meta name="application-name" content={SITE.title} />
    {baiduVerification && <meta name="baidu-site-verification" content={baiduVerification} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/assets/echo-avatar.jpg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content={type === "profile" ? "profile" : type} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <ClientRouter />
  </head>
  <body class:list={{ "is-immersive": immersive }}>
    <DotField tone={type === "article" ? "dim" : "default"} />
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class:list={["site-frame", { "site-frame--immersive": immersive }]}>
      <Header />
      <main id="main-content" tabindex="-1" data-pagefind-body={searchIndex ? "" : undefined}>
        <slot />
      </main>
      <Footer />
    </div>
    <CommandPalette />
    <script>
      import { setupMotionSystem } from "@/scripts/motion";

      document.addEventListener("astro:page-load", setupMotionSystem);
      setupMotionSystem();
    </script>
  </body>
</html>
