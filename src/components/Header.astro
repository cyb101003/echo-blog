---
import { NAV_ITEMS, SITE } from "@/config";

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${SITE.author}首页`}>{SITE.shortTitle}</a>
  <nav class="site-nav" aria-label="主要导航" data-site-nav>
    {NAV_ITEMS.filter(item => item.href !== "/search/").map(item => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        <span>{item.index}</span>
        {item.label}
      </a>
    ))}
    <i class="nav-indicator" aria-hidden="true"></i>
  </nav>
  <button class="nav-command" type="button" data-cmdk-trigger aria-label="打开命令面板，搜索文章、项目或跳转页面">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5" /><path d="m16 16 5 5" /></svg>
    <span data-label>搜索</span>
    <span class="kbd" aria-hidden="true">⌘K</span>
  </button>
  <div class="header-foot">
    <p><span class="status-dot" aria-hidden="true"></span>OPEN TO LEARN</p>
  </div>
</header>
