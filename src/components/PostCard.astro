---
import type { CollectionEntry } from "astro:content";

type Props = { post: CollectionEntry<"posts">; index?: number; headingLevel?: "h2" | "h3" };
const { post, index = 0, headingLevel: Heading = "h2" } = Astro.props;
const date = post.data.publishedAt.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<article data-reveal style={`--reveal-index: ${index}`}>
  <a class="post-row" href={`/posts/${post.id}/`} aria-label={`阅读《${post.data.title}》`} data-reading-card={post.id}>
    <p class="post-index">{String(index + 1).padStart(2, "0")}</p>
    <div class="post-copy">
      <div class="post-meta"><time datetime={post.data.publishedAt.toISOString()}>{date}</time><span>{post.data.tags[0] ?? "记录"}</span></div>
      <Heading class="post-title">{post.data.title}</Heading>
      {post.data.description && <p>{post.data.description}</p>}
      <span class="post-read-progress" data-reading-track hidden aria-hidden="true">
        <span><i data-reading-value></i></span>
        <em data-reading-label></em>
      </span>
    </div>
    <span class="round-link motion-arrow" aria-hidden="true">↗</span>
  </a>
</article>
