---
import { SITE } from "@/config";

const year = new Date().getFullYear();
const socialLinks = [
  { label: "GitHub", href: SITE.github, icon: "github" },
  { label: "YouTube · @Echo-bb-1003", href: SITE.youtube, icon: "youtube" },
  { label: "X · @Echo101003", href: SITE.x, icon: "x" },
  { label: "知乎 · 个人介绍", href: SITE.zhihu, icon: "zhihu" }
];
---

<footer class="site-footer">
  <div class="footer-callout" data-reveal>
    <p class="kicker">END / KEEP BUILDING</p>
    <p class="footer-title">下一次更新，应该比这次更好。</p>
  </div>
  <div class="footer-meta" data-reveal>
    <div class="social-links" aria-label="社交平台">
      {socialLinks.map(item => (
        <a class={`social-link social-link--${item.icon}`} href={item.href} target="_blank" rel={item.icon === "zhihu" ? "noreferrer" : "me noreferrer"} aria-label={item.label} title={item.label}>
          {item.icon === "github" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.28-1.29-5.28-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.97 10.97 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.71 5.4-5.29 5.69.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>}
          {item.icon === "youtube" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>}
          {item.icon === "x" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.2-8.2L.8 2h6.4l4.4 5.8L18.9 2Zm-1.1 17.9h1.7L6.3 4H4.5l13.3 15.9Z"/></svg>}
          {item.icon === "zhihu" && <span class="social-glyph" aria-hidden="true">知</span>}
          <span class="social-tooltip" aria-hidden="true">{item.label}</span>
        </a>
      ))}
    </div>
    <div class="footer-legal"><a href="/about/">关于 Echo（陈宇博）</a><p>© {year} Echo · Built with Astro</p></div>
  </div>
</footer>
