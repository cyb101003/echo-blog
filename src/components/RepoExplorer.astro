---
import github from "@/data/github.json";
import { privateProjects } from "@/data/projects";

const labels: Record<string, string> = {
  private: "私有案例",
  original: "原创",
  fork: "Fork",
  archived: "归档",
  template: "模板",
  mirror: "镜像"
};

const projects = [
  ...privateProjects,
  ...github.repositories.map(repo => ({
    ...repo,
    label: labels[repo.kind],
    action: "GitHub ↗",
    external: true,
    facts: [repo.language || "文档", `★ ${repo.stars}`, `Fork ${repo.forks}`, `更新 ${new Date(repo.updatedAt).toLocaleDateString("zh-CN")}`]
  }))
];
const kinds = ["all", ...new Set(projects.map(project => project.kind))];
const counts = Object.fromEntries(kinds.map(kind => [kind, kind === "all" ? projects.length : projects.filter(project => project.kind === kind).length]));
---

<section class="repo-explorer" data-repo-explorer>
  <div class="repo-toolbar">
    <div class="repo-filters" role="group" aria-label="筛选仓库类型">
      {kinds.map(kind => (
        <button type="button" class:list={["filter-button", { active: kind === "all" }]} data-kind={kind} aria-pressed={kind === "all" ? "true" : "false"}>
          {kind === "all" ? "全部" : labels[kind]} <span>{counts[kind]}</span>
        </button>
      ))}
    </div>
    <p class="sync-label">
      <span aria-hidden="true"></span>
      {github.syncedAt ? `私有案例 + GitHub 同步 · ${new Date(github.syncedAt).toLocaleDateString("zh-CN")}` : "私有案例 + 本地缓存"}
    </p>
  </div>

  <div class="repo-list" aria-live="polite">
    {projects.map((project, index) => (
      <article data-repo-kind={project.kind}>
        <a
          class="repo-row"
          href={project.url}
          target={project.external ? "_blank" : undefined}
          rel={project.external ? "noreferrer" : undefined}
          aria-label={project.external ? `在 GitHub 查看 ${project.name}` : `查看 ${project.name} 项目案例`}
        >
          <p class="repo-index">{String(index + 1).padStart(2, "0")}</p>
          <div class="repo-copy">
            <div class="repo-heading">
              <h2>{project.name}</h2>
              <span class="repo-kind">{project.label}</span>
            </div>
            <p>{project.description}</p>
            <ul class="repo-facts" aria-label="项目信息">
              {project.facts.map(fact => <li>{fact}</li>)}
            </ul>
          </div>
          <span class="round-link" aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
  <p class="repo-empty" data-repo-empty hidden>这个分类还没有项目。</p>
</section>

<script>
  function setupRepoExplorer() {
    const explorer = document.querySelector("[data-repo-explorer]");
    if (!(explorer instanceof HTMLElement) || explorer.dataset.ready === "true") return;
    explorer.dataset.ready = "true";
    const buttons = [...explorer.querySelectorAll("[data-kind]")];
    const rows = [...explorer.querySelectorAll("[data-repo-kind]")];
    const empty = explorer.querySelector("[data-repo-empty]");

    buttons.forEach(button => button.addEventListener("click", () => {
      const kind = button.getAttribute("data-kind") || "all";
      buttons.forEach(item => {
        const selected = item === button;
        item.classList.toggle("active", selected);
        item.setAttribute("aria-pressed", String(selected));
      });
      let visible = 0;
      rows.forEach(row => {
        const show = kind === "all" || row.getAttribute("data-repo-kind") === kind;
        row.toggleAttribute("hidden", !show);
        if (show) visible += 1;
      });
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    }));
  }

  document.addEventListener("astro:page-load", setupRepoExplorer);
  setupRepoExplorer();
</script>
