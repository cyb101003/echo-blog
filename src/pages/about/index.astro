---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import github from "@/data/github.json";
import { SITE } from "@/config";
---

<BaseLayout type="profile" title="关于 Echo（陈宇博）" description="认识 Echo（陈宇博）：15 岁 builder、元创岛联合创始人、Horizon AI 产品经理，以及他的项目与成长记录。">
  <section class="page-section about-page">
    <SectionTitle index="01A" eyebrow="ABOUT / IDENTITY" title="Echo（陈宇博）" description="15 岁 builder · 元创岛联合创始人 · Horizon AI 产品经理" />

    <div class="about-profile" data-reveal>
      <div class="about-portrait">
        <img src="/assets/echo-avatar.jpg" width="430" height="440" alt={`${SITE.author}使用的猫咪头像，戴着黑框眼镜`} data-image-reveal />
        <p><strong>{SITE.age}</strong><span>YEARS OLD</span></p>
      </div>
      <div class="about-story">
        <p class="about-lead">我是 {SITE.author}。比起只给自己贴上“开发者”的标签，我更喜欢 builder——把想法变成真正能运行、能被使用的东西。</p>
        <p>目前我是<strong>元创岛联合创始人</strong>和 <strong>Horizon AI 产品经理</strong>。我会在技术实现、产品判断与真实项目之间来回切换，也会把过程中的取舍、踩过的坑和仍未想明白的问题留在这里。</p>
        <p>我曾参与举办 <a href="https://horizon-startup.com" target="_blank" rel="noreferrer">Horizon Startup</a> 黑客松并担任 CTO，负责技术方向与活动网站的实现和交付。这些真实经历比一串技能名更能说明我正在做什么。</p>

        <div class="about-roles" aria-label="当前身份">
          <article>
            <span>01 / CO-FOUNDER</span>
            <h2>元创岛联合创始人</h2>
            <p>以联合创始人的身份参与元创岛的项目推进与长期建设。</p>
          </article>
          <article>
            <span>02 / AI PRODUCT</span>
            <h2>Horizon AI 产品经理</h2>
            <p>以产品经理的身份参与 AI 产品工作，让技术能力落到具体体验与真实需求上。</p>
          </article>
        </div>

        <p>目前 GitHub 账号 <a href={SITE.github} target="_blank" rel="noreferrer">@cyb101003</a> 有 {github.repositories.length} 个公开仓库，其中 {github.repositories.filter(repo => repo.kind === "original").length} 个原创项目、{github.repositories.filter(repo => repo.kind === "fork").length} 个 Fork。</p>
        <div class="about-credentials" aria-label="个人资料与外部链接">
          <div><span>姓名</span><strong>Echo（陈宇博）</strong></div>
          <div><span>GitHub</span><a href={SITE.github} target="_blank" rel="noreferrer">@cyb101003 ↗</a></div>
          <div><span>知乎</span><a href={SITE.zhihu} target="_blank" rel="noreferrer">查看个人介绍 ↗</a></div>
        </div>
        <div class="about-actions">
          <a class="button-primary" href="/projects/">查看项目 <span class="motion-arrow">↗</span></a>
          <a class="button-quiet" href={SITE.zhihu} target="_blank" rel="noreferrer">知乎介绍 ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about-timeline" aria-labelledby="about-timeline-title" data-reveal>
    <header class="about-timeline-head">
      <p class="kicker">TRACE / 正在发生</p>
      <h2 id="about-timeline-title">到目前为止</h2>
      <p>只记录已经发生的事。还没写清楚的阶段，会明确标成待补充，而不是填一个好看的年份。</p>
    </header>
    <ol class="timeline">
      <li data-current="true">
        <p class="timeline-kicker"><b>NOW</b><span>PRODUCT</span></p>
        <h3>Horizon AI 产品经理</h3>
        <p>参与 AI 产品的定义与落地，在模型能力、交互体验和真实需求之间做取舍。</p>
      </li>
      <li data-current="true">
        <p class="timeline-kicker"><b>NOW</b><span>BUILDING</span></p>
        <h3>元创岛联合创始人</h3>
        <p>以联合创始人身份参与项目推进与长期建设，负责技术方向与产品实现的衔接。</p>
      </li>
      <li>
        <p class="timeline-kicker"><b>2026</b><span>CTO</span></p>
        <h3>Horizon Startup 黑客松</h3>
        <p>担任 CTO，负责活动技术方向，以及官网的实现与交付。</p>
      </li>
      <li data-pending="true">
        <p class="timeline-kicker"><b>—</b><span>TO BE WRITTEN</span></p>
        <h3>更早的经历</h3>
        <p>还在整理。这一段补上之前，先留空。</p>
      </li>
    </ol>
  </section>
</BaseLayout>
