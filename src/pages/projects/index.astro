---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import RepoExplorer from "@/components/RepoExplorer.astro";
---

<BaseLayout title="项目 — Echo" description="Echo（陈宇博）的项目案例与 GitHub 公开仓库，包括私有项目、原创、Fork、归档、模板与镜像。">
  <section class="page-section">
    <SectionTitle index="02" eyebrow="PROJECTS & REPOSITORIES" title="项目档案" description="公开仓库会在构建时自动同步；不适合开源的项目只展示背景、职责和非敏感技术总结，不公开源码。" />
    <RepoExplorer />
  </section>
</BaseLayout>
