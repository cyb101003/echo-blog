---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import ContributionsGrid from "@/components/ContributionsGrid.astro";
import ScrollMarquee from "@/components/ScrollMarquee.astro";
import Odometer from "@/components/Odometer.astro";
import github from "@/data/github.json";
import { privateProjects } from "@/data/projects";
import { SITE } from "@/config";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const projects = [
  ...privateProjects,
  ...github.repositories.map(repo => ({
    ...repo,
    label: repo.kind === "original" ? "原创" : "Fork",
    action: "GitHub ↗",
    external: true
  }))
];
const originals = github.repositories.filter(repo => repo.kind === "original").length + privateProjects.length;
const forks = github.repositories.filter(repo => repo.kind === "fork").length;
const originalShare = projects.length ? Math.round((originals / projects.length) * 100) : 0;
const latestPost = posts[0]?.data.publishedAt;
---

<BaseLayout immersive>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="kicker hero-identity" data-entrance style="--entrance-delay: 40ms">
        {SITE.age} Y/O BUILDER · <span class="hero-name-decode" data-decode-name={SITE.displayName} aria-label={SITE.displayName}>{SITE.displayName}</span><span class="hero-name-native">（{SITE.realName}）</span>
      </p>
      <h1 id="home-title" data-entrance style="--entrance-delay: 120ms">把有趣的ideas落地</h1>
      <p class="hero-intro" data-entrance style="--entrance-delay: 240ms">你好，我是 {SITE.author}，一名 {SITE.age} 岁的 builder，也是元创岛联合创始人、Horizon Startup 内蒙古负责人。我在这里记录项目、产品判断、文章，以及还没有答案的实验。</p>
      <div class="hero-actions" data-entrance style="--entrance-delay: 340ms">
        <a class="button-primary" href="/projects/">浏览项目 <span class="motion-arrow" aria-hidden="true">↗</span></a>
        <a class="button-quiet" href="/about/">认识我</a>
      </div>
      <ul class="hero-meta" aria-label="当前身份与个人介绍" data-entrance style="--entrance-delay: 430ms">
        {SITE.roles.map((role, index) => (
          <li><span>{String(index + 1).padStart(2, "0")} / {role.eyebrow}</span><strong>{role.shortLabel}</strong></li>
        ))}
        <li class="hero-meta-link"><a href={SITE.zhihu} target="_blank" rel="noreferrer"><span>{String(SITE.roles.length + 1).padStart(2, "0")} / PROFILE</span><strong>知乎介绍 ↗</strong></a></li>
      </ul>
    </div>

    <aside class="profile-panel beam" aria-label={`${SITE.author}的个人头像`} data-entrance style="--entrance-delay: 180ms">
      <div class="profile-image-wrap">
        <img src="/assets/echo-avatar.jpg" width="430" height="440" alt={`${SITE.author}使用的猫咪头像，戴着黑框眼镜`} data-image-reveal />
      </div>
      <div class="profile-caption">
        <p><span class="status-dot" aria-hidden="true"></span>正在学习，也正在构建</p>
        <a href="/about/" aria-label={`查看关于${SITE.author}的更多信息`}>ABOUT / 2026 ↗</a>
      </div>
    </aside>
  </section>

  <section class="home-stats" aria-label="公开数据">
    <a href="/projects/" data-reveal style="--reveal-index: 0">
      <Odometer value={projects.length} />
      <span>项目展示</span>
      <em class="stat-chip"><i aria-hidden="true"></i>私有案例 {privateProjects.length}</em>
      <b class="motion-arrow" aria-hidden="true">↗</b>
    </a>
    <a href="/projects/" data-reveal style="--reveal-index: 1">
      <Odometer value={originals} />
      <span>原创项目</span>
      <em class="stat-chip"><i aria-hidden="true"></i>占全部 {originalShare}%</em>
      <b class="motion-arrow" aria-hidden="true">↗</b>
    </a>
    <a href={SITE.github} target="_blank" rel="noreferrer" data-reveal style="--reveal-index: 2">
      <Odometer value={forks} />
      <span>Fork 项目</span>
      <em class="stat-chip" data-tone="quiet"><i aria-hidden="true"></i>来自 @cyb101003</em>
      <b class="motion-arrow" aria-hidden="true">↗</b>
    </a>
    <a href="/posts/" data-reveal style="--reveal-index: 3">
      <Odometer value={posts.length} />
      <span>近期文章</span>
      <em class="stat-chip" data-tone="quiet">
        <i aria-hidden="true"></i>
        {latestPost ? `最近 ${latestPost.toLocaleDateString("zh-CN", { month: "numeric", day: "numeric" })}` : "等待第一篇"}
      </em>
      <b class="motion-arrow" aria-hidden="true">↗</b>
    </a>
  </section>

  <ScrollMarquee />

  <ContributionsGrid />

  <section class="home-section" id="projects">
    <header class="home-section-head" data-reveal>
      <div><span>01</span><p class="kicker">PUBLIC WORK</p></div>
      <div><h2>项目展示</h2><p>公开仓库与私有项目案例都放在这里；展示成果，但不泄漏不该公开的源码。</p><a href="/projects/">查看项目档案 <span class="motion-arrow" aria-hidden="true">→</span></a></div>
    </header>
    <div class="featured-repos">
      {projects.map((project, index) => (
        <a
          class="featured-repo"
          href={project.url}
          target={project.external ? "_blank" : undefined}
          rel={project.external ? "noreferrer" : undefined}
          data-repo-index={String(index + 1).padStart(2, "0")}
          data-reveal
          style={`--reveal-index: ${index}`}
        >
          <span>{String(index + 1).padStart(2, "0")} / {project.label}</span>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <b>{project.action} <i class="motion-arrow" aria-hidden="true">↗</i></b>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section" id="notes">
    <header class="home-section-head" data-reveal>
      <div><span>02</span><p class="kicker">LATEST NOTES</p></div>
      <div><h2>最近在写</h2><p>项目背后的过程、判断和踩过的坑。</p><a href="/posts/">查看全部文章 <span class="motion-arrow" aria-hidden="true">→</span></a></div>
    </header>
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>
</BaseLayout>
