---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import github from "@/data/github.json";
import { privateProjects } from "@/data/projects";
import { SITE } from "@/config";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const posts = allPosts.slice(0, 3);
const featuredNames = ["video-studio", "rednote-tools", "echo-blog"];
const projects = [
  ...privateProjects,
  ...featuredNames.flatMap(name => {
    const repo = github.repositories.find(repo => repo.name === name && repo.kind === "original");
    return repo ? [{ ...repo, label: repo.language ?? "开源项目", action: "查看源码", external: true }] : [];
  })
].slice(0, 3);
---

<BaseLayout immersive>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="kicker hero-identity" data-entrance>Echo（陈宇博） / {SITE.age} 岁的 builder</p>
      <h1 id="home-title" data-entrance style="--entrance-delay: 80ms">把有趣的想法，<br /><span>变成真实的作品。</span></h1>
      <p class="hero-intro" data-entrance style="--entrance-delay: 160ms">写代码，做产品，也记录一路上的思考。<br />这里有我的项目、技术笔记和成长记录。</p>
      <div class="hero-actions" data-entrance style="--entrance-delay: 240ms">
        <a class="button-primary" href="#notes">阅读文章 <span class="motion-arrow" aria-hidden="true">↓</span></a>
        <a class="button-quiet" href="/projects/">浏览项目 <span class="motion-arrow" aria-hidden="true">↗</span></a>
      </div>
      <ul class="hero-roles" aria-label="当前身份" data-entrance style="--entrance-delay: 320ms">
        {SITE.roles.map(role => <li>{role.label}</li>)}
      </ul>
    </div>
    <a class="portrait-link" href="/about/" aria-label="认识 Echo（陈宇博）" data-entrance style="--entrance-delay: 160ms">
      <div class="portrait-image">
        <img src="/assets/echo-avatar.jpg" width="430" height="440" alt="Echo 的头像：戴着黑框眼镜的猫咪" fetchpriority="high" />
      </div>
      <span class="portrait-name">认识 Echo <span class="motion-arrow" aria-hidden="true">↗</span></span>
    </a>
  </section>

  <nav class="home-summary" aria-label="博客概览">
    <a href="/posts/"><strong>{allPosts.length.toString().padStart(2, "0")}</strong><span>篇文章</span><i aria-hidden="true">↗</i></a>
    <a href="/projects/"><strong>{github.repositories.length.toString().padStart(2, "0")}</strong><span>个公开仓库</span><i aria-hidden="true">↗</i></a>
    <a href="/rss.xml"><strong>RSS</strong><span>订阅更新</span><i aria-hidden="true">↗</i></a>
  </nav>

  <section class="journal-section" id="notes" aria-labelledby="notes-title">
    <header class="journal-heading">
      <h2 id="notes-title">最近在写</h2>
      <a href="/posts/">全部文章 <span class="motion-arrow" aria-hidden="true">↗</span></a>
    </header>
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} headingLevel="h3" />)}
    </div>
  </section>

  <section class="journal-section" id="projects" aria-labelledby="projects-title">
    <header class="journal-heading">
      <h2 id="projects-title">做过的项目</h2>
      <a href="/projects/">全部项目 <span class="motion-arrow" aria-hidden="true">↗</span></a>
    </header>
    <div class="project-grid">
      {projects.map((project, index) => (
        <a class="project-card" href={project.url} target={project.external ? "_blank" : undefined} rel={project.external ? "noreferrer" : undefined}>
          <span class="project-card-meta"><span>{String(index + 1).padStart(2, "0")} / {project.label}</span><span class="motion-arrow" aria-hidden="true">↗</span></span>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <span class="project-card-action">{project.action.replace(/\s*↗$/, "")}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  :global(.site-frame--immersive) .home-hero {
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(40px, 7vw, 112px);
    width: min(calc(100% - 64px), 1080px);
    min-height: 640px;
    padding: 154px 0 72px;
    border-bottom: 0;
  }
  :global(.site-frame--immersive) .hero-copy h1 {
    margin-top: 24px;
    font-size: clamp(2.5rem, 4.2vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.35;
    white-space: normal;
  }
  :global(.site-frame--immersive) .hero-copy h1 span {
    color: var(--accent);
    white-space: normal;
  }
  :global(.site-frame--immersive) .hero-identity {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  :global(.site-frame--immersive) .hero-intro {
    margin-top: 22px;
    font-size: 1.0625rem;
    line-height: 1.9;
  }
  :global(.site-frame--immersive) .hero-actions {
    margin-top: 28px;
  }
  :global(.site-frame--immersive) .hero-actions a {
    min-width: 144px;
    font-family: var(--sans);
    font-size: 0.875rem;
    letter-spacing: 0;
  }
  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 28px 0 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    list-style: none;
  }
  .hero-roles li::before {
    display: inline-block;
    width: 4px;
    height: 4px;
    margin: 0 8px 3px 0;
    background: var(--accent);
    content: "";
  }
  .portrait-link {
    display: block;
    text-decoration: none;
  }
  .portrait-image {
    overflow: hidden;
    aspect-ratio: 1;
    border: 1px solid var(--line-strong);
    background: var(--panel);
  }
  .portrait-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }
  .portrait-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .home-summary,
  .journal-section {
    width: min(calc(100% - 64px), 1080px);
    margin-inline: auto;
  }
  .home-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line-strong);
  }
  .home-summary a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-height: 76px;
    padding: 24px 0;
    text-decoration: none;
  }
  .home-summary a + a {
    padding-left: 28px;
    border-left: 1px solid var(--line);
  }
  .home-summary strong {
    font: 500 1.375rem/1.2 var(--mono);
    letter-spacing: -0.05em;
  }
  .home-summary span {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .home-summary i {
    margin-left: auto;
    padding-right: 24px;
    color: var(--muted);
    font-size: 0.875rem;
    font-style: normal;
  }
  .journal-section {
    padding: 72px 0;
    scroll-margin-top: 104px;
  }
  .journal-section + .journal-section {
    padding-top: 0;
  }
  .journal-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 30px;
  }
  .journal-heading h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
  }
  .journal-heading > a {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease;
  }
  .project-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
    font: 500 0.75rem/1.5 var(--mono);
  }
  .project-card h3 {
    margin: 28px 0 12px;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .project-card p {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }
  .project-card-action {
    margin-top: auto;
    color: var(--accent);
    font-size: 0.8125rem;
  }
  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
    }
    .portrait-link:hover img {
      transform: scale(1.025);
    }
    .journal-heading > a:hover,
    .home-summary a:hover,
    .portrait-link:hover .portrait-name {
      color: var(--accent);
    }
  }
  @media (max-width: 900px) {
    :global(.site-frame--immersive) .home-hero {
      grid-template-columns: minmax(0, 1fr) 200px;
      gap: 32px;
      min-height: 580px;
      padding-top: 136px;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
    .project-card {
      padding: 24px;
    }
    .project-card h3 {
      margin-top: 16px;
    }
    .project-card p {
      max-width: 60ch;
      margin-bottom: 20px;
    }
  }
  @media (max-width: 639px) {
    :global(.site-frame--immersive) .home-hero {
      position: relative;
      display: block;
      width: calc(100% - 40px);
      min-height: 0;
      padding: 112px 0 40px;
    }
    :global(.site-frame--immersive) .hero-copy {
      padding-top: 84px;
    }
    :global(.site-frame--immersive) .hero-copy h1 {
      margin-top: 18px;
      font-size: clamp(1.8rem, 7.8vw, 2.6rem);
      line-height: 1.4;
    }
    :global(.site-frame--immersive) .hero-identity {
      font-size: 0.75rem;
    }
    :global(.site-frame--immersive) .hero-intro {
      margin-top: 18px;
      font-size: 1rem;
    }
    :global(.site-frame--immersive) .hero-actions {
      grid-template-columns: 1fr 1fr;
      margin-top: 24px;
    }
    :global(.site-frame--immersive) .hero-actions a {
      min-width: 0;
    }
    .hero-roles {
      gap: 8px;
      margin-top: 22px;
    }
    .hero-roles li {
      width: 100%;
    }
    .portrait-link {
      position: absolute;
      top: 94px;
      left: 0;
      width: 64px;
    }
    .portrait-image {
      border-radius: 50%;
    }
    .portrait-name {
      display: none;
    }
    .home-summary,
    .journal-section {
      width: calc(100% - 40px);
    }
    .home-summary a {
      flex-direction: column;
      gap: 6px;
      padding: 18px 0;
    }
    .home-summary a + a {
      padding-left: 16px;
    }
    .home-summary strong {
      font-size: 1.125rem;
    }
    .home-summary span {
      font-size: 0.75rem;
    }
    .home-summary i {
      display: none;
    }
    .journal-section {
      padding: 44px 0;
      scroll-margin-top: 88px;
    }
    .journal-heading {
      gap: 12px;
      margin-bottom: 22px;
    }
    .journal-heading h2 {
      font-size: 1.625rem;
    }
    .journal-heading > a {
      gap: 8px;
      font-size: 0.8125rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .portrait-image img {
      transition: none;
    }
  }
</style>
