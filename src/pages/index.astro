---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import github from "@/data/github.json";
import { SITE } from "@/config";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const originals = github.repositories.filter(repo => repo.kind === "original").length;
const forks = github.repositories.filter(repo => repo.kind === "fork").length;
---

<BaseLayout immersive>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="kicker">{SITE.age} Y/O DEVELOPER · Echo</p>
      <h1 id="home-title">把有趣的ideas落地</h1>
      <p class="hero-intro">你好，我是 echo，一名 {SITE.age} 岁的builder，我在这里记录项目、文章，以及还没有答案的实验。</p>
      <div class="hero-actions">
        <a class="button-primary" href="/projects/">浏览项目 <span>↗</span></a>
        <a class="button-quiet" href="/about/">认识我</a>
      </div>
      <ul class="hero-meta" aria-label="关注方向">
        <li><span>01</span>AI</li>
        <li><span>02</span>Web</li>
        <li><span>03</span>Open Source</li>
      </ul>
    </div>

    <aside class="profile-panel" aria-label="echo 的个人头像">
      <div class="profile-image-wrap">
        <img src="/assets/echo-avatar.jpg" width="430" height="440" alt="echo 的猫咪头像，戴着黑框眼镜" />
      </div>
      <div class="profile-caption">
        <p><span class="status-dot" aria-hidden="true"></span>正在学习，也正在构建</p>
        <a href="/about/" aria-label="查看关于 echo 的更多信息">ABOUT / 2026 ↗</a>
      </div>
    </aside>
  </section>

  <section class="home-stats" aria-label="公开数据">
    <a href="/projects/"><strong>{github.repositories.length}</strong><span>公开仓库</span><b>↗</b></a>
    <a href="/projects/"><strong>{originals}</strong><span>原创项目</span><b>↗</b></a>
    <a href="/projects/"><strong>{forks}</strong><span>Fork 项目</span><b>↗</b></a>
    <a href="/posts/"><strong>{posts.length}</strong><span>近期文章</span><b>↗</b></a>
  </section>

  <section class="home-section" id="projects">
    <header class="home-section-head">
      <div><span>01</span><p class="kicker">PUBLIC WORK</p></div>
      <div><h2>公开项目</h2><p>原创、Fork 和仍在探索中的想法，都完整保留。</p><a href="/projects/">查看项目档案 →</a></div>
    </header>
    <div class="featured-repos">
      {github.repositories.map((repo, index) => (
        <a class="featured-repo" href={repo.url} target="_blank" rel="noreferrer" data-repo-index={String(index + 1).padStart(2, "0")}>
          <span>{String(index + 1).padStart(2, "0")} / {repo.kind === "original" ? "原创" : "Fork"}</span>
          <h3>{repo.name}</h3>
          <p>{repo.description}</p>
          <b>GitHub ↗</b>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section" id="notes">
    <header class="home-section-head">
      <div><span>02</span><p class="kicker">LATEST NOTES</p></div>
      <div><h2>最近在写</h2><p>项目背后的过程、判断和踩过的坑。</p><a href="/posts/">查看全部文章 →</a></div>
    </header>
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>
</BaseLayout>

<script>
  function setupHomeReveal() {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealTargets = [...document.querySelectorAll(".home-stats a, .featured-repo, .post-row")];
    if (reducedMotion || !("IntersectionObserver" in window)) {
      revealTargets.forEach(item => item.classList.add("is-visible"));
      return;
    }

    revealTargets.forEach(item => item.classList.add("reveal-ready"));
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    revealTargets.forEach(item => observer.observe(item));
  }

  document.addEventListener("astro:page-load", setupHomeReveal);
  setupHomeReveal();
</script>
